# Euclid likelihood
# Cross-correlation of photometric probes

# Based on an earlier euclid_lensing likelihood
# by Sprenger et al. 1801.08331

# Developped by Maike Doerenkamp, Lena Rathmann, Julien Lesgourgues
# Following the validation recipe of
# Euclid Collaboration et al. 1910.09237

# data directory and fiducial file
euclid_photometric.data_directory = data.path['data']
euclid_photometric.fiducial_file  = "euclid_photometric_fiducial"

#evaluated probes. Choose from ['WL','GCph','WL_GCph_XC']
euclid_photometric.probe = ['WL_GCph_XC']
# euclid_photometric.probe = ['WL']
# euclid_photometric.probe = ['GCph']

# evaluated l-values
euclid_photometric.lmin = 10
# lmax_WL >= lmax_GC, lmax_XC

# optimistic case:
# euclid_photometric.lmax_WL=5000
# euclid_photometric.lmax_GC=3000
# euclid_photometric.lmax_XC=3000

# pessimistic case:
# euclid_photometric.lmax_WL=1500
# euclid_photometric.lmax_GC=750
# euclid_photometric.lmax_XC=750

euclid_photometric.lmax_WL = 5000
euclid_photometric.lmax_GC = 3000
euclid_photometric.lmax_XC = 3000

# number of discrete l values
euclid_photometric.lbin = 100

# Survey specifications
# Covered redshift
euclid_photometric.zmin = 0.001
euclid_photometric.zmax  = 2.5
#euclid_photometric.zmax  = 3.731
# number of bins
euclid_photometric.nbin  = 10
# sky coverage
euclid_photometric.fsky  = 0.3636
# number of galaxies per square arcminutes
euclid_photometric.gal_per_sqarcmn = 30.0

# Computational precision
# number of discrete z values in integrations
euclid_photometric.nzmax = 200

# noise computation
euclid_photometric.rms_shear = 0.30
# non-linear correction
euclid_photometric.use_halofit = False
# note even if False, halofit will be used if the .param
# file or any other likelihood specifies halofit

# Evaluted k-values in h/Mpc
euclid_photometric.k_min_h_by_Mpc = 0.001
euclid_photometric.k_max_h_by_Mpc = 50.0

# use scale-independent growth factor f (like in IST:Fisher)
# or scale-dependent one (like in f(R) or neutrino papers)
euclid_photometric.scale_dependent_f = True

# Bias model
euclid_photometric.bias_model = 'binned'

# what tracer to use for the GCph ('clustering' or 'matter')
euclid_photometric.use_tracer = 'matter'

# baryonic feedback
euclid_photometric.use_BCemu = False
euclid_photometric.verbose_BCemu = True
euclid_photometric.BCemu_k_bins = 200
euclid_photometric.BCemu_z_bins = 20

# Theory error
euclid_photometric.theoretical_error = False
euclid_photometric.minimize_Terr_binned = True
euclid_photometric.fR_error = 0.02

# model shift checks
euclid_photometric.fit_different_data = False
#########################
euclid_photometric.data_use_BCemu= True
euclid_photometric.data_use_tracer= "clustering"


# debugging
#########################
euclid_photometric.printtimes = False
euclid_photometric.save_PS = False
euclid_photometric.save_Cell = False